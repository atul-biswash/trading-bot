+    provider, _, _ = build_provider({("BTCUSDT", "1m"): []})
+    await provider.start()
+
+    assert provider.candle_count("BTCUSDT", "1m") == 0
+    assert provider.is_ready("BTCUSDT", "1m", 0) is False
+
