# ===========================================================================
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#   cp .env.example .env
# All secrets live here; non-secret behaviour lives in config.yaml.
# ===========================================================================

# ---- Binance API (LIVE) ----------------------------------------------------
# Live keys: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_live_api_key_here
BINANCE_API_SECRET=your_live_api_secret_here

# ---- Binance API (TESTNET) -------------------------------------------------
# Testnet keys (free): https://testnet.binance.vision/
# If left blank while running in testnet mode, the app falls back to the
# BINANCE_API_KEY / BINANCE_API_SECRET values above.
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ---- Mode override ---------------------------------------------------------
# Optional. Overrides "mode:" in config.yaml. One of: testnet | live | paper | backtest
# Leaving this unset keeps the safe default from config.yaml (testnet).
# BOT_MODE=testnet

# ---- Telegram notifications ------------------------------------------------
# Create a bot with @BotFather to get the token; message @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- Misc ------------------------------------------------------------------
# Path to the YAML config (default: config.yaml)
# BOT_CONFIG_PATH=config.yaml
# Override log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
